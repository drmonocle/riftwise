<?xml version="1.0" encoding="UTF-8"?>
<!-- lolworlds.com/riftwatch: the oldest address of RiftWise (renamed 2026-10-16, v0.4.0; moved to riftwise.gg in
     v0.6.0). Installed on HomeServer as C:\inetpub\wwwroot\riftwatch\web.config, next to a copy of web/sw.js.
     - Every page, link and bookmark forwards straight to the same page on riftwise.gg (301, always https).
     - What installed RiftWatch apps (0.3.40 and older) read keeps answering here, unchanged: the stats data,
       stream-status.json and the alerts API, so they keep working until they update themselves.
     - sw.js stays: browsers that turned on alerts at /riftwatch/ keep showing them. -->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="Old app: stats data" stopProcessing="true">
                    <match url="^stats/(latest\.json|\d+/.*)$" />
                    <action type="Rewrite" url="/riftwise/stats/{R:1}" />
                </rule>
                <rule name="Old app: stream status" stopProcessing="true">
                    <match url="^stream-status\.json$" />
                    <action type="Rewrite" url="/riftwise/stream-status.json" />
                </rule>
                <rule name="Old alerts API" stopProcessing="true">
                    <match url="^api/push/(.*)$" />
                    <action type="Rewrite" url="http://127.0.0.1:8092/riftwise/api/push/{R:1}" appendQueryString="true" />
                </rule>
                <rule name="Alerts service worker" stopProcessing="true">
                    <match url="^sw\.js$" />
                    <action type="None" />
                </rule>
                <rule name="Everything else: riftwise.gg" stopProcessing="true">
                    <match url="^(.*)$" />
                    <action type="Redirect" url="https://riftwise.gg/{R:1}" redirectType="Permanent" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
    <location path="sw.js">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
