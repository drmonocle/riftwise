<?xml version="1.0" encoding="UTF-8"?>
<!-- lolworlds.com/riftwise: RiftWise's address from 2026-10-16 until it moved to riftwise.gg (v0.6.0). Installed on
     HomeServer as C:\inetpub\wwwroot\riftwise\web.config (a copy of this file; the web build no longer goes there).
     - Every page, link and bookmark forwards to the same page on riftwise.gg (301, so search engines move the pages
       over, and always https).
     - What installed apps (0.5.1 and older) read keeps answering here, unchanged: the stats data (also the build's
       own folder: riftwise.gg/stats is a virtual folder pointing here), stream-status.json and the sync / alerts APIs.
     - sw.js and the icons stay: browsers that turned on alerts here keep showing them.
     - move.html hands this browser's saved settings over to riftwise.gg (a browser keeps them per site). -->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="RiftWise Sync API" stopProcessing="true">
                    <match url="^api/sync/(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:8094/riftwise/api/sync/{R:1}" appendQueryString="true" />
                </rule>
                <rule name="RiftWise Push API" stopProcessing="true">
                    <match url="^api/push/(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:8092/riftwise/api/push/{R:1}" appendQueryString="true" />
                </rule>
                <rule name="Installed apps and alerts keep answering here" stopProcessing="true">
                    <match url="^(stats/(latest\.json|\d+/.*)|stream-status\.json|sw\.js|move\.html|icon-[\w-]+\.png)$" />
                    <action type="None" />
                </rule>
                <rule name="Every page: riftwise.gg" stopProcessing="true">
                    <match url="^(.*)$" />
                    <action type="Redirect" url="https://riftwise.gg/{R:1}" redirectType="Permanent" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
        <staticContent>
            <remove fileExtension=".csv" />
            <mimeMap fileExtension=".csv" mimeType="text/csv; charset=utf-8" />
        </staticContent>
    </system.webServer>

    <location path="sw.js">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="move.html">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="stats">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
            </staticContent>
            <httpProtocol>
                <customHeaders>
                    <add name="Access-Control-Allow-Origin" value="*" />
                </customHeaders>
            </httpProtocol>
        </system.webServer>
    </location>
    <location path="stats/latest.json">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <!-- The stream owner's break / return note (edited by hand on the server, not part of the build). -->
    <location path="stream-status.json">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
            <httpProtocol>
                <customHeaders>
                    <add name="Access-Control-Allow-Origin" value="*" />
                </customHeaders>
            </httpProtocol>
        </system.webServer>
    </location>
</configuration>
