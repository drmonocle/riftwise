<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS settings for lolworlds.com/riftwatch/ (the RiftWatch web build). Inherits the site's security headers. -->
<configuration>
    <system.webServer>
        <!-- Phone/browser alerts: the riftwatch-push service on this server (C:\Sites\riftwatch-push-data). -->
        <rewrite>
            <rules>
                <rule name="RiftWatch Push API" stopProcessing="true">
                    <match url="^api/push/(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:8092/riftwatch/api/push/{R:1}" appendQueryString="true" />
                </rule>
                <!-- Stats pages (player/faker, team/t1, tournament/..., match/..., champion/..., stats/...) and their
                     sitemaps: the riftwatch-pages service on this server returns index.html with each page's own
                     title and link-preview tags. Data files under stats/<version>/ and stats/latest.json stay static. -->
                <rule name="RiftWatch Stats Pages" stopProcessing="true">
                    <match url="^((?:player|team|tournament|match|champion|league)/[^/]+|stats(?:/(?:tournaments(?:/\d{4})?|leagues|champions|patches|records|titles|compare|data|about|prep|rankings|finder|draft))?|sitemap(?:-[a-z]+-\d+)?\.xml)/?$" />
                    <action type="Rewrite" url="http://127.0.0.1:8093/riftwatch/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
        <!-- Hashed assets in assets/ are immutable; cache them for a year. -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            <!-- IIS serves nothing for an extension it doesn't know; the PWA manifest needs this. -->
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
            <!-- the free data downloads (stats/<version>/hub/csv/*.csv) -->
            <remove fileExtension=".csv" />
            <mimeMap fileExtension=".csv" mimeType="text/csv; charset=utf-8" />
        </staticContent>
    </system.webServer>

    <!-- The page and the service worker must always be re-checked, or browsers keep an old build. -->
    <location path="index.html">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="sw.js">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="manifest.webmanifest">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
    <!-- Stats tab data (built nightly by scripts/stats/build_stats.py). Versioned folders never change,
         so they can be cached; latest.json says which version is current and must always be re-checked.
         The desktop app reads these from another origin, so allow cross-origin reads. -->
    <location path="stats">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
            </staticContent>
            <httpProtocol>
                <customHeaders>
                    <add name="Access-Control-Allow-Origin" value="*" />
                </customHeaders>
            </httpProtocol>
        </system.webServer>
    </location>
    <!-- The stream owner's break / return note (edited by hand on the server, not part of the build). -->
    <location path="stream-status.json">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
            <httpProtocol>
                <customHeaders>
                    <add name="Access-Control-Allow-Origin" value="*" />
                </customHeaders>
            </httpProtocol>
        </system.webServer>
    </location>
    <location path="stats/latest.json">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
