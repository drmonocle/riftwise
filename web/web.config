<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS settings for lolworlds.com/riftwatch/ (the RiftWatch web build). Inherits the site's security headers. -->
<configuration>
    <system.webServer>
        <!-- Hashed assets in assets/ are immutable; cache them for a year. -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            <!-- IIS serves nothing for an extension it doesn't know; the PWA manifest needs this. -->
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        </staticContent>
    </system.webServer>

    <!-- The page and the service worker must always be re-checked, or browsers keep an old build. -->
    <location path="index.html">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="sw.js">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="manifest.webmanifest">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
    <!-- Stats tab data (built nightly by scripts/stats/build_stats.py). Versioned folders never change,
         so they can be cached; latest.json says which version is current and must always be re-checked.
         The desktop app reads these from another origin, so allow cross-origin reads. -->
    <location path="stats">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
            </staticContent>
            <httpProtocol>
                <customHeaders>
                    <add name="Access-Control-Allow-Origin" value="*" />
                </customHeaders>
            </httpProtocol>
        </system.webServer>
    </location>
    <location path="stats/latest.json">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
