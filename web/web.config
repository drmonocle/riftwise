<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS settings for riftwise.gg (the RiftWise web build), its own IIS site "riftwise.gg" on HomeServer:
     C:\inetpub\riftwise.gg, with the stats data as the virtual folder stats -> C:\inetpub\wwwroot\riftwise\stats.
     The old address lolworlds.com/riftwise has its own settings (server/iis/lolworlds-riftwise.web.config). -->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- One address: www.riftwise.gg, riftwise.lol and www.riftwise.lol forward to riftwise.gg (always https:
                     Cloudflare also serves plain http, and a relative target would send people there). -->
                <rule name="RiftWise one address" stopProcessing="true">
                    <match url="^(.*)$" />
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^(www\.riftwise\.gg|(www\.)?riftwise\.lol)$" />
                    </conditions>
                    <action type="Redirect" url="https://riftwise.gg/{R:1}" redirectType="Permanent" appendQueryString="true" />
                </rule>
                <!-- Accounts and cloud sync: the riftwise-sync service on this server. -->
                <rule name="RiftWise Sync API" stopProcessing="true">
                    <match url="^api/sync/(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:8094/riftwise/api/sync/{R:1}" appendQueryString="true" />
                </rule>
                <!-- Phone/browser alerts: the riftwise-push service on this server (C:\Sites\riftwise-push-data). -->
                <rule name="RiftWise Push API" stopProcessing="true">
                    <match url="^api/push/(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:8092/riftwise/api/push/{R:1}" appendQueryString="true" />
                </rule>
                <!-- Stats pages (player/faker, team/t1, tournament/..., match/..., champion/..., stats/...) and their
                     sitemaps: the riftwise-pages service on this server returns index.html with each page's own
                     title and link-preview tags. Data files under stats/<version>/ and stats/latest.json stay static. -->
                <rule name="RiftWise Stats Pages" stopProcessing="true">
                    <match url="^((?:player|team|tournament|match|champion|league)/[^/]+|about|stats(?:/(?:tournaments(?:/\d{4})?|leagues|champions|patches|records|titles|compare|data|about|prep|rankings|finder|draft|best))?|sitemap(?:-[a-z]+-\d+)?\.xml)/?$" />
                    <action type="Rewrite" url="http://127.0.0.1:8093/riftwise/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
        <!-- Security headers (the same as lolworlds.com's); remove first, so nothing is added twice. -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <remove name="X-Content-Type-Options" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <remove name="X-Frame-Options" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <remove name="Referrer-Policy" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <remove name="Permissions-Policy" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
                <remove name="Strict-Transport-Security" />
                <add name="Strict-Transport-Security" value="max-age=31536000" />
                <remove name="Content-Security-Policy" />
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.twitch.tv https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; worker-src 'self'; frame-src 'self' https://player.twitch.tv https://*.twitch.tv https://www.youtube.com https://www.youtube-nocookie.com https://*.youtube.com;" />
            </customHeaders>
        </httpProtocol>
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />
        <!-- Hashed assets in assets/ are immutable; cache them for a year. -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            <!-- IIS serves nothing for an extension it doesn't know; the PWA manifest needs this. -->
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
            <!-- the free data downloads (stats/<version>/hub/csv/*.csv) -->
            <remove fileExtension=".csv" />
            <mimeMap fileExtension=".csv" mimeType="text/csv; charset=utf-8" />
        </staticContent>
    </system.webServer>

    <!-- The page and the service worker must always be re-checked, or browsers keep an old build. -->
    <location path="index.html">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="sw.js">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="manifest.webmanifest">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="robots.txt">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
    <!-- Stats tab data (built by scripts/stats/build_stats.py). Versioned folders never change, so they can be
         cached; latest.json says which version is current and must always be re-checked. The desktop app reads
         these from another origin, so allow cross-origin reads. -->
    <location path="stats">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
            </staticContent>
            <httpProtocol>
                <customHeaders>
                    <remove name="Access-Control-Allow-Origin" />
                    <add name="Access-Control-Allow-Origin" value="*" />
                </customHeaders>
            </httpProtocol>
        </system.webServer>
    </location>
    <location path="stats/latest.json">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
